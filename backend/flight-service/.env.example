# Copy to .env for running outside Docker (npm run dev). Docker Compose sets these itself.
PORT=3004
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flight_db
# Leave REDIS_URL empty to run without a cache
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
# Live Google Flights search through SerpApi (optional; empty = catalog only)
SERPAPI_API_KEY=
# Per-attempt timeout, retries for timeouts/5xx/429, and how long a searched route+date is reused
SERPAPI_TIMEOUT_MS=8000
SERPAPI_RETRIES=1
SERPAPI_REUSE_MINUTES=30
