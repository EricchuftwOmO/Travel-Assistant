# Copy to .env for running outside Docker (npm run dev). Docker Compose sets these itself.
PORT=3008
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=llm_db
# Leave REDIS_URL empty to run without a cache
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# Without a key the service stores placeholder advice (source "stub")
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=30000
