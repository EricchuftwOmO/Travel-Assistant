# Copy to .env for running outside Docker (npm run dev). Docker Compose sets these itself.
PORT=3009
# The database is created on first start if the server does not have it
DATABASE_URL=postgres://postgres:postgres@localhost:5432/user_db
# Secret used to sign login tokens; the gateway and trip service check them with the same value
JWT_SECRET=replace-with-a-long-random-string
# Deleting an account also deletes the user's trips in the trip service
TRIP_SERVICE_URL=http://localhost:3001
