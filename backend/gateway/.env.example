# Copy to .env for local runs (npm start reads it).
PORT=8080

# Service URLs (in Docker Compose: service names, e.g. http://trip-service:3001)
TRIP_SERVICE_URL=http://localhost:3001
# The Activity Service answers /api/activities
SEARCH_SERVICE_URL=http://localhost:3007
BUDGET_SERVICE_URL=http://localhost:3003
# AI Planner (stretch goal). Leave empty and /api/planner/* returns 404.
PLANNER_SERVICE_URL=

# Timeouts in milliseconds
UPSTREAM_TIMEOUT_MS=5000
PLANNER_TIMEOUT_MS=60000
HEALTH_TIMEOUT_MS=2000

# Path each service serves its own health check on
SERVICE_HEALTH_PATH=/health

# Browser origins allowed to call the API, comma-separated ("*" = any)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_REQUESTS=true

# Flight, Hotel, Car Rental and LLM services (LLM_TIMEOUT_MS: a model can be slow)
FLIGHT_SERVICE_URL=http://localhost:3004
HOTEL_SERVICE_URL=http://localhost:3005
CAR_RENTAL_SERVICE_URL=http://localhost:3006
LLM_SERVICE_URL=http://localhost:3008
LLM_TIMEOUT_MS=40000

# The gateway checks login tokens (JWT) before forwarding. Must equal the trip service's JWT_SECRET.
JWT_SECRET=dev-only-change-me
