# Copy to .env for running outside Docker (npm run dev). Docker Compose sets these itself.
PORT=3001
# The database is created on first start if the server does not have it
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trip_db
# Checks login tokens issued by the user service; must equal the user service's JWT_SECRET
JWT_SECRET=replace-with-a-long-random-string
# Attaching a flight to a trip reads its details from the flight service
FLIGHT_SERVICE_URL=http://localhost:3004
# Google Places API (New) key for GET /api/places/nearby and /locate (optional)
GOOGLE_PLACES_API_KEY=
