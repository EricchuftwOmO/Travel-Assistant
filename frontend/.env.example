# Copy to .env to change where the app finds the API gateway.
VITE_API_URL=http://localhost:8080
# Google Maps browser key for the Add place map (optional; restrict it to your site in Google Cloud)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# Sign in with Google: the OAuth web client ID (public). Leave empty to hide the button.
# It must be the same value as GOOGLE_CLIENT_ID in the user service, and the page's address
# (e.g. http://localhost:5173) must be an authorised JavaScript origin in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
