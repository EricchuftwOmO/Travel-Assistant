# Copy to .env (same folder as docker-compose.yml). Docker Compose reads it automatically.
# Everything is optional: without a .env file the system still starts.

# PostgreSQL user and password shared by the five services (the database server runs in Docker)
DB_USER=postgres
DB_PASSWORD=postgres

# Language model for the LLM service. Leave GROQ_API_KEY empty to get labelled placeholder
# answers (source "stub"); everything else works the same. Never commit a real key.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
