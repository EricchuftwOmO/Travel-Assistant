# Copy to .env (same folder as docker-compose.yml). Docker Compose reads it automatically.
# Everything is optional: without a .env file the system still starts.

# PostgreSQL user and password shared by the services (the database server runs in Docker)
DB_USER=postgres
DB_PASSWORD=postgres

# Signs login tokens (user service); the gateway and trip service check them. Use a long random value; the built-in default is for local development only.
JWT_SECRET=replace-with-a-long-random-string

# Language model for the LLM service. Leave GROQ_API_KEY empty to get labelled placeholder
# answers (source "stub"); everything else works the same. Never commit a real key.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Google Maps Platform (optional). Enable "Places API (New)" and "Maps JavaScript API" for the key.
# GOOGLE_PLACES_API_KEY is used by the trip service (server side). The map in the browser uses
# GOOGLE_MAPS_API_KEY, or the Places key when that is empty. The browser key is visible to users,
# so restrict it to your site (HTTP referrers) in Google Cloud. Rebuild the frontend after changing it.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
# Optional map ID from Google Cloud Map Management (the default DEMO_MAP_ID is fine for development)
GOOGLE_MAP_ID=
