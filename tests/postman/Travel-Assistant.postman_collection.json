    {
      "name": "4. Recommendation summary (business logic)",
      "description": "POST /api/advice/recommendations: the LLM service calls the Flight, Hotel and Activity services, picks a package, adds up the cost in code and saves the summary.",
      "item": [
        {
          "name": "Recommend a 5-night Tokyo trip within $2500",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Location header points at the saved advice', () => pm.expect(pm.response.headers.get('Location')).to.eql(`/api/advice/${body.id}`));",
                  "pm.test('total equals the sum of the breakdown (computed in code)', () => pm.expect(body.total).to.be.closeTo(body.breakdown.flights + body.breakdown.hotel + body.breakdown.activities, 0.01));",
                  "pm.test('within budget and remaining is budget minus total', () => { pm.expect(body.within_budget).to.eql(true); pm.expect(body.remaining).to.be.closeTo(body.budget - body.total, 0.01); });",
                  "pm.test('selection uses real ids', () => { pm.expect(body.selection.flight_id).to.be.a('number'); pm.expect(body.selection.hotel_id).to.be.a('number'); pm.expect(body.selection.activity_ids).to.be.an('array').that.is.not.empty; });",
                  "pm.test('summary is saved and mentions the total', () => pm.expect(body.summary).to.include('Total $'));",
                  "pm.collectionVariables.set('recoId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"postman\",\n  \"trip_id\": 1,\n  \"origin\": \"SEA\",\n  \"destination\": \"Tokyo\",\n  \"nights\": 5,\n  \"travelers\": 1,\n  \"budget\": 2500,\n  \"preferences\": \"food and museums\"\n}",
              "options": {
                "raw": {
                  "language": "json"
