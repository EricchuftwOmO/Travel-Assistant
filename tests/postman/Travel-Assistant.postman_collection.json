{
  "info": {
    "name": "Travel Assistant API (Phase II)",
    "description": "Runs against the API gateway (docker compose up --build). Covers CRUD, filtering, validation errors, and the recommendation summary (business logic). Every request has tests; records it creates it deletes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Gateway liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(body.status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Combined service health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 503 (degraded)', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "const body = pm.response.json();",
                  "['flight', 'hotel', 'carRental', 'search', 'llm'].forEach((s) => pm.test(`${s} service is up`, () => pm.expect(body.services[s].status).to.eql('up')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Returns 503 (degraded) while the planned Trip and Budget services do not exist; the services built so far must be up."
          }
        }
      ]
    },
